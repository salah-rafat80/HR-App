datasource db {
  provider = "postgresql"
}

enum LeaveType {
  annual
  sick
  emergency
  maternityPaternity
  unpaid
  study
  hajj
  bereavement
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum ApprovalStepStatus {
  pending
  approved
  rejected
}

enum HalfDayPeriod {
  morning
  afternoon
}

enum AttendanceStatus {
  present
  absent
  late
  workFromHome
  onBusinessTrip
  onLeave
  none
}

enum OvertimeStatus {
  pending
  approved
  rejected
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String
  role          String

  department    String?
  title         String?

  managerId     String?
  manager       User?          @relation("ManagerHierarchy", fields: [managerId], references: [id])
  directReports User[]         @relation("ManagerHierarchy")

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  attendanceRecords AttendanceRecord[]
  shiftInfos        ShiftInfo[]
  overtimeRequests  OvertimeRequest[]
  kpis              Kpi[]
  kpiQuarterScores  KpiQuarterScore[]
}

model LeaveBalance {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      LeaveType
  daysUsed  Int       @default(0)
  daysTotal Int
}

model LeaveRequest {
  id               String              @id @default(uuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id])
  type             LeaveType
  startDate        DateTime
  endDate          DateTime
  isHalfDay        Boolean
  halfDayPeriod    HalfDayPeriod?
  reason           String
  hasAttachment    Boolean             @default(false)
  overallStatus    LeaveStatus         @default(pending)
  currentStepOrder Int                 @default(1)
  approvalSteps    LeaveApprovalStep[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model LeaveApprovalStep {
  id        String             @id @default(uuid())
  requestId String
  request   LeaveRequest       @relation(fields: [requestId], references: [id])
  stepName  String
  status    ApprovalStepStatus
  stepOrder Int                @default(0)
  timestamp DateTime
}

// ---------------------------------------------------------
// STUBBED MODELS FOR OTHER MODULES (To be implemented later)
// ---------------------------------------------------------

model AttendanceRecord {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  date          DateTime         @db.Date
  clockInTime   DateTime?
  clockOutTime  DateTime?
  status        AttendanceStatus
  locationLabel String
  clockInLat    Float?
  clockInLng    Float?
  distanceMeters Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model CompanySettings {
  id                  String   @id @default(uuid())
  companyName         String   @default("Demo Company")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model OfficeBranch {
  id             String   @id @default(uuid())
  name           String
  latitude       Float
  longitude      Float
  radiusMeters   Int      @default(200)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ShiftInfo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  shiftName String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OvertimeRequest {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  date           DateTime       @db.Date
  hoursRequested Float
  reason         String
  status         OvertimeStatus @default(pending)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Kpi {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  title               String
  description         String
  departmentObjective String
  targetValue         Float
  currentValue        Float
  selfAssessmentText  String?
  hasEvidence         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model KpiQuarterScore {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  quarterLabel        String
  averageScorePercent Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AppraisalResult {
  id        String   @id @default(uuid())
  // Add fields later
  createdAt DateTime @default(now())
}

model PayrollRun {
  id        String   @id @default(uuid())
  // Add fields later
  createdAt DateTime @default(now())
}

model TrainingCourse {
  id        String   @id @default(uuid())
  // Add fields later
  createdAt DateTime @default(now())
}

model JobRequisition {
  id        String   @id @default(uuid())
  // Add fields later
  createdAt DateTime @default(now())
}

model Candidate {
  id        String   @id @default(uuid())
  // Add fields later
  createdAt DateTime @default(now())
}

model OrgNode {
  id        String   @id @default(uuid())
  // Add fields later
  createdAt DateTime @default(now())
}

model NewHireOnboarding {
  id        String   @id @default(uuid())
  // Add fields later
  createdAt DateTime @default(now())
}

model OffboardingCase {
  id        String   @id @default(uuid())
  // Add fields later
  createdAt DateTime @default(now())
}
