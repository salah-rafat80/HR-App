datasource db {
  provider = "postgresql"
}

enum LeaveType {
  annual
  sick
  emergency
  maternityPaternity
  unpaid
  study
  hajj
  bereavement
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum ApprovalStepStatus {
  pending
  approved
  rejected
}

enum HalfDayPeriod {
  morning
  afternoon
}

enum AttendanceStatus {
  present
  absent
  late
  workFromHome
  onBusinessTrip
  onLeave
  none
}

enum OvertimeStatus {
  pending
  approved
  rejected
  pending_team_lead
  pending_hr
  rejected_by_team_lead
  rejected_by_hr
  cancelled
  expired
  completed
}

enum OvertimeSessionStatus {
  active
  completed
  cancelled
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id                String         @id @default(uuid())
  employeeCode      String?        @unique
  email             String         @unique
  password          String
  name              String
  role              String
  isActive          Boolean        @default(true)
  passwordChangedAt DateTime?
  fcmToken          String?

  department        String?
  title             String?

  managerId         String?
  manager           User?          @relation("ManagerHierarchy", fields: [managerId], references: [id])
  directReports     User[]         @relation("ManagerHierarchy")

  leaveRequests            LeaveRequest[]
  leaveBalances            LeaveBalance[]
  attendanceRecords        AttendanceRecord[]
  shiftInfos               ShiftInfo[]
  overtimeRequests         OvertimeRequest[]         @relation("OvertimeEmployee")
  teamLeadOvertimeRequests OvertimeRequest[]         @relation("OvertimeTeamLead")
  hrOvertimeRequests       OvertimeRequest[]         @relation("OvertimeHrApprover")
  overtimeSessions         OvertimeSession[]         @relation("OvertimeSessionUser")
  companyHolidaysCreated   CompanyHoliday[]          @relation("CompanyHolidayCreator")
  kpis                     Kpi[]
  kpiQuarterScores         KpiQuarterScore[]
  selfAppraisalAnswers     SelfAppraisalAnswer[]
  peerFeedbacksSent        PeerFeedback[]            @relation("PeerFeedbackFrom")
  peerFeedbacksReceived    PeerFeedback[]            @relation("PeerFeedbackTo")
  categoryRatings          AppraisalCategoryRating[]
  developmentGoals         DevelopmentGoal[]
  careerSteps              CareerStep[]
  payslips                 Payslip[]
  bonusNotices             BonusNotice[]
  auditLogs                AuditLog[]                @relation("AuditActor")

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([employeeCode])
  @@index([managerId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorUser   User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  timestamp   DateTime @default(now())

  @@index([timestamp])
  @@index([actorUserId])
  @@index([targetType, targetId])
}

model LeaveBalance {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      LeaveType
  daysUsed  Int       @default(0)
  daysTotal Int
}

model LeaveRequest {
  id               String              @id @default(uuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id])
  type             LeaveType
  startDate        DateTime
  endDate          DateTime
  isHalfDay        Boolean
  halfDayPeriod    HalfDayPeriod?
  reason           String
  hasAttachment    Boolean             @default(false)
  overallStatus    LeaveStatus         @default(pending)
  currentStepOrder Int                 @default(1)
  approvalSteps    LeaveApprovalStep[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([userId, overallStatus, startDate, endDate])
}

model LeaveApprovalStep {
  id        String             @id @default(uuid())
  requestId String
  request   LeaveRequest       @relation(fields: [requestId], references: [id])
  stepName  String
  status    ApprovalStepStatus
  stepOrder Int                @default(0)
  timestamp DateTime
}

model AttendanceRecord {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  date             DateTime          @db.Date
  clockInTime      DateTime?
  clockOutTime     DateTime?
  status           AttendanceStatus
  locationLabel    String
  clockInLat       Float?
  clockInLng       Float?
  distanceMeters   Float?
  overtimeRequests OvertimeRequest[]
  overtimeSessions OvertimeSession[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId, status, date])
  // ARTIFACT ONLY — unique constraint to prevent concurrent duplicate check-ins.
  // Not applied to the database until explicitly approved and migrated.
  @@unique([userId, date], name: "AttendanceRecord_userId_date_key")
}

model CompanySettings {
  id                  String   @id @default(uuid())
  companyName         String   @default("Demo Company")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model OfficeBranch {
  id             String   @id @default(uuid())
  name           String
  latitude       Float
  longitude      Float
  radiusMeters   Int      @default(200)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ShiftInfo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  shiftName String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OvertimeRequest {
  id                 String            @id @default(uuid())
  userId             String
  user               User              @relation("OvertimeEmployee", fields: [userId], references: [id])
  attendanceRecordId String?
  attendanceRecord   AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id])
  date               DateTime          @db.Date
  requestedStartAt   DateTime?
  requestedEndAt     DateTime?
  requestedMinutes   Int?
  hoursRequested     Float?
  reason             String
  status             OvertimeStatus    @default(pending_team_lead)
  teamLeadId         String?
  teamLead           User?             @relation("OvertimeTeamLead", fields: [teamLeadId], references: [id])
  teamLeadDecisionAt DateTime?
  teamLeadComment    String?
  hrApproverId       String?
  hrApprover         User?             @relation("OvertimeHrApprover", fields: [hrApproverId], references: [id])
  hrDecisionAt       DateTime?
  hrComment          String?
  session            OvertimeSession?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([userId, date])
  @@index([status, date])
  @@index([teamLeadId, status, date])
}

model OvertimeSession {
  id                  String                @id @default(uuid())
  overtimeRequestId   String                @unique
  overtimeRequest     OvertimeRequest       @relation(fields: [overtimeRequestId], references: [id])
  userId              String
  user                User                  @relation("OvertimeSessionUser", fields: [userId], references: [id])
  attendanceRecordId  String
  attendanceRecord    AttendanceRecord      @relation(fields: [attendanceRecordId], references: [id])
  status              OvertimeSessionStatus @default(active)
  startedAt           DateTime              @default(now())
  endedAt             DateTime?
  actualMinutes       Int?
  startLocationLabel  String?
  startLatitude       Float?
  startLongitude      Float?
  startGpsAccuracy    Float?
  startDistanceMeters Float?
  endLocationLabel    String?
  endLatitude         Float?
  endLongitude        Float?
  endGpsAccuracy      Float?
  endDistanceMeters   Float?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([userId, startedAt])
}

model CompanyHoliday {
  id          String   @id @default(uuid())
  date        DateTime @unique @db.Date
  name        String
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("CompanyHolidayCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Kpi {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  title               String
  description         String
  departmentObjective String
  targetValue         Float
  currentValue        Float
  selfAssessmentText  String?
  hasEvidence         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
}

model KpiQuarterScore {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  quarterLabel        String
  averageScorePercent Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, quarterLabel(sort: Desc)])
}

enum AppraisalStatus {
  upcoming
  inProgress
  completed
}

model AppraisalCycle {
  id                    String                 @id @default(uuid())
  label                 String
  status                AppraisalStatus        @default(upcoming)
  dueDate               DateTime
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  selfAppraisalAnswers  SelfAppraisalAnswer[]
  peerFeedbacks         PeerFeedback[]
  categoryRatings       AppraisalCategoryRating[]
}

model SelfAppraisalAnswer {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  cycleId      String
  cycle        AppraisalCycle @relation(fields: [cycleId], references: [id])
  questionId   String
  questionText String
  answerText   String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([userId, cycleId, questionId])
}

model PeerFeedback {
  id           String         @id @default(uuid())
  fromUserId   String
  fromUser     User           @relation("PeerFeedbackFrom", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User           @relation("PeerFeedbackTo", fields: [toUserId], references: [id])
  cycleId      String
  cycle        AppraisalCycle @relation(fields: [cycleId], references: [id])
  feedbackText String?
  submitted    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([fromUserId, toUserId, cycleId])
}

model AppraisalCategoryRating {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  cycleId        String
  cycle          AppraisalCycle @relation(fields: [cycleId], references: [id])
  categoryName   String
  score          Float
  managerComment String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, cycleId, categoryName])
}

model DevelopmentGoal {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  title           String
  progressPercent Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum CareerStepStatus {
  completed
  current
  upcoming
}

model CareerStep {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  roleTitle String
  status    CareerStepStatus @default(upcoming)
  order     Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

enum PayslipLineItemType {
  allowance
  deduction
}

enum PayrollStatus {
  draft
  processing
  pendingApproval
  approved
  paid
}

model PayrollRun {
  id            String        @id @default(uuid())
  periodLabel   String
  status        PayrollStatus @default(draft)
  totalAmount   Decimal       @default(0) @db.Decimal(12, 2)
  employeeCount Int           @default(0)
  payslips      Payslip[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Payslip {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  monthLabel   String
  baseSalary   Decimal           @db.Decimal(12, 2)
  netPay       Decimal           @db.Decimal(12, 2)
  payrollRunId String
  payrollRun   PayrollRun        @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  lineItems    PayslipLineItem[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([userId, payrollRunId])
  @@index([userId])
}

model PayslipLineItem {
  id        String              @id @default(uuid())
  label     String
  amount    Decimal             @db.Decimal(12, 2)
  type      PayslipLineItemType
  payslipId String
  payslip   Payslip             @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model BonusNotice {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  monthLabel String
  amount     Decimal  @db.Decimal(12, 2)
  message    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model TrainingCourse {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model JobRequisition {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model Candidate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model OrgNode {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model NewHireOnboarding {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model OffboardingCase {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}
