datasource db {
  provider = "postgresql"
}

enum LeaveType {
  annual
  sick
  emergency
  maternityPaternity
  unpaid
  study
  hajj
  bereavement
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum ApprovalStepStatus {
  pending
  approved
  rejected
}

enum HalfDayPeriod {
  morning
  afternoon
}

enum AttendanceStatus {
  present
  absent
  late
  workFromHome
  onBusinessTrip
  onLeave
  none
}

enum OvertimeStatus {
  pending
  approved
  rejected
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String
  role          String

  department    String?
  title         String?

  managerId     String?
  manager       User?          @relation("ManagerHierarchy", fields: [managerId], references: [id])
  directReports User[]         @relation("ManagerHierarchy")

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  attendanceRecords AttendanceRecord[]
  shiftInfos        ShiftInfo[]
  overtimeRequests  OvertimeRequest[]
  kpis              Kpi[]
  kpiQuarterScores  KpiQuarterScore[]
  selfAppraisalAnswers  SelfAppraisalAnswer[]
  peerFeedbacksSent     PeerFeedback[]            @relation("PeerFeedbackFrom")
  peerFeedbacksReceived PeerFeedback[]            @relation("PeerFeedbackTo")
  categoryRatings       AppraisalCategoryRating[]
  developmentGoals      DevelopmentGoal[]
  careerSteps           CareerStep[]
}

model LeaveBalance {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      LeaveType
  daysUsed  Int       @default(0)
  daysTotal Int
}

model LeaveRequest {
  id               String              @id @default(uuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id])
  type             LeaveType
  startDate        DateTime
  endDate          DateTime
  isHalfDay        Boolean
  halfDayPeriod    HalfDayPeriod?
  reason           String
  hasAttachment    Boolean             @default(false)
  overallStatus    LeaveStatus         @default(pending)
  currentStepOrder Int                 @default(1)
  approvalSteps    LeaveApprovalStep[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model LeaveApprovalStep {
  id        String             @id @default(uuid())
  requestId String
  request   LeaveRequest       @relation(fields: [requestId], references: [id])
  stepName  String
  status    ApprovalStepStatus
  stepOrder Int                @default(0)
  timestamp DateTime
}

// ---------------------------------------------------------
// STUBBED MODELS FOR OTHER MODULES (To be implemented later)
// ---------------------------------------------------------

model AttendanceRecord {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  date          DateTime         @db.Date
  clockInTime   DateTime?
  clockOutTime  DateTime?
  status        AttendanceStatus
  locationLabel String
  clockInLat    Float?
  clockInLng    Float?
  distanceMeters Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model CompanySettings {
  id                  String   @id @default(uuid())
  companyName         String   @default("Demo Company")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model OfficeBranch {
  id             String   @id @default(uuid())
  name           String
  latitude       Float
  longitude      Float
  radiusMeters   Int      @default(200)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ShiftInfo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  shiftName String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OvertimeRequest {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  date           DateTime       @db.Date
  hoursRequested Float
  reason         String
  status         OvertimeStatus @default(pending)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Kpi {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  title               String
  description         String
  departmentObjective String
  targetValue         Float
  currentValue        Float
  selfAssessmentText  String?
  hasEvidence         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model KpiQuarterScore {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  quarterLabel        String
  averageScorePercent Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum AppraisalStatus {
  upcoming
  inProgress
  completed
}

model AppraisalCycle {
  id                    String                 @id @default(uuid())
  label                 String
  status                AppraisalStatus        @default(upcoming)
  dueDate               DateTime
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  selfAppraisalAnswers  SelfAppraisalAnswer[]
  peerFeedbacks         PeerFeedback[]
  categoryRatings       AppraisalCategoryRating[]
}

model SelfAppraisalAnswer {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  cycleId      String
  cycle        AppraisalCycle @relation(fields: [cycleId], references: [id])
  questionId   String
  questionText String
  answerText   String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([userId, cycleId, questionId])
}

model PeerFeedback {
  id           String         @id @default(uuid())
  fromUserId   String
  fromUser     User           @relation("PeerFeedbackFrom", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User           @relation("PeerFeedbackTo", fields: [toUserId], references: [id])
  cycleId      String
  cycle        AppraisalCycle @relation(fields: [cycleId], references: [id])
  feedbackText String?
  submitted    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([fromUserId, toUserId, cycleId])
}

model AppraisalCategoryRating {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  cycleId        String
  cycle          AppraisalCycle @relation(fields: [cycleId], references: [id])
  categoryName   String
  score          Float
  managerComment String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, cycleId, categoryName])
}

model DevelopmentGoal {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  title           String
  progressPercent Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum CareerStepStatus {
  completed
  current
  upcoming
}

model CareerStep {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  roleTitle String
  status    CareerStepStatus @default(upcoming)
  order     Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model PayrollRun {
  id        String   @id @default(uuid())
  // Add fields later
  createdAt DateTime @default(now())
}

model TrainingCourse {
  id        String   @id @default(uuid())
  // Add fields later
  createdAt DateTime @default(now())
}

model JobRequisition {
  id        String   @id @default(uuid())
  // Add fields later
  createdAt DateTime @default(now())
}

model Candidate {
  id        String   @id @default(uuid())
  // Add fields later
  createdAt DateTime @default(now())
}

model OrgNode {
  id        String   @id @default(uuid())
  // Add fields later
  createdAt DateTime @default(now())
}

model NewHireOnboarding {
  id        String   @id @default(uuid())
  // Add fields later
  createdAt DateTime @default(now())
}

model OffboardingCase {
  id        String   @id @default(uuid())
  // Add fields later
  createdAt DateTime @default(now())
}
