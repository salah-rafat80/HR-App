{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HR App Mobile (Render Host)",
      "cwd": "apps/mobile",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=API_BASE_URL=https://hr-app-lswi.onrender.com"
      ]
    },
    {
      "name": "HR App Web (Render Host)",
      "cwd": "apps/web",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define=API_BASE_URL=https://hr-app-lswi.onrender.com"
      ]
    },
    {
      "name": "HR App Mobile (Android Emulator)",
      "cwd": "apps/mobile",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=API_BASE_URL=http://10.0.2.2:3000"
      ]
    },
    {
      "name": "HR App Web (Local Backend)",
      "cwd": "apps/web",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define=API_BASE_URL=http://localhost:3000"
      ]
    }
  ]
}
